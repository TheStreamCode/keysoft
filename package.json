{
  "name": "keysoft",
  "version": "2.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheStreamCode/keysoft.git"
  },
  "bugs": {
    "url": "https://github.com/TheStreamCode/keysoft/issues"
  },
  "homepage": "https://github.com/TheStreamCode/keysoft#readme",
  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo start --android --go",
    "web": "expo start --web",
    "build:android:preview": "bunx eas-cli build --platform android --profile preview",
    "build:android:production": "bunx eas-cli build --platform android --profile production",
    "submit:android:production": "bunx eas-cli submit --platform android --profile production",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7.15.11",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/stack": "^7.8.11",
    "crypto-js": "^4.2.0",
    "expo": "~56.0.15",
    "expo-build-properties": "~56.0.22",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.20",
    "expo-crypto": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-image-picker": "~56.0.20",
    "expo-local-authentication": "~56.0.4",
    "expo-localization": "~56.0.6",
    "expo-navigation-bar": "~56.0.3",
    "expo-notifications": "~56.0.20",
    "expo-screen-capture": "~56.0.4",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.21",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-argon2": "^4.0.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "typescript": "~6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.9"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
