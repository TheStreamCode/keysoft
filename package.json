{
  "name": "keysoft",
  "author": {
    "name": "Michael Gasperini",
    "url": "https://mikesoft.it"
  },
  "version": "3.3.3",
  "description": "Private, offline-first password manager for Android. No accounts, ads, tracking, or cloud vault.",
  "keywords": [
    "android",
    "encryption",
    "expo",
    "offline-first",
    "password-manager",
    "react-native",
    "security"
  ],
  "packageManager": "bun@1.3.14",
  "repository": "github:TheStreamCode/keysoft",
  "bugs": {
    "url": "https://github.com/TheStreamCode/keysoft/issues"
  },
  "homepage": "https://play.google.com/store/apps/details?id=it.mikesoft.keysoft",
  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo start --android --go",
    "web": "expo start --web",
    "build:android:preview": "bun x eas-cli build --platform android --profile preview",
    "build:android:production": "bun x eas-cli build --platform android --profile production",
    "build:ios:preview": "bun x eas-cli build --platform ios --profile preview",
    "build:ios:simulator": "bun x eas-cli build --platform ios --profile ios-simulator",
    "submit:android:production": "bun x eas-cli submit --platform android --profile production",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "jest",
    "test:ci": "jest --ci --coverage --runInBand",
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run test:ci && bun x expo-doctor",
    "deps:audit": "bun audit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@react-navigation/stack": "^7.10.22",
    "crypto-js": "^4.2.0",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.20",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-argon2": "^4.0.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^8.0.1",
    "@react-native/jest-preset": "~0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^16.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.3.0"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "private": true,
  "license": "Apache-2.0"
}
