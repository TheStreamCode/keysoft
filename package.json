{
  "name": "keysoft",
  "author": "Michael Gasperini (Mikesoft)",
  "version": "3.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheStreamCode/keysoft.git"
  },
  "bugs": {
    "url": "https://github.com/TheStreamCode/keysoft/issues"
  },
  "homepage": "https://github.com/TheStreamCode/keysoft#readme",
  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo start --android --go",
    "web": "expo start --web",
    "build:android:preview": "bunx eas-cli build --platform android --profile preview",
    "build:android:production": "bunx eas-cli build --platform android --profile production",
    "build:ios:preview": "bunx eas-cli build --platform ios --profile preview",
    "build:ios:simulator": "bunx eas-cli build --platform ios --profile ios-simulator",
    "submit:android:production": "bunx eas-cli submit --platform android --profile production",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.6",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7.18.13",
    "@react-navigation/native": "^7.3.13",
    "@react-navigation/native-stack": "^7.18.5",
    "@react-navigation/stack": "^7.10.16",
    "crypto-js": "^4.2.0",
    "expo": "~57.0.7",
    "expo-asset": "~57.0.6",
    "expo-build-properties": "~57.0.6",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.5",
    "expo-local-authentication": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.6",
    "expo-screen-capture": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-argon2": "^4.0.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "typescript": "~6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.86.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.9"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "private": true,
  "license": "Apache-2.0"
}
